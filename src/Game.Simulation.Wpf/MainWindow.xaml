<Window x:Class="Game.Simulation.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Expedition Simulation Inspector" Height="900" Width="1440" MinHeight="680" MinWidth="1024"
        Background="#171A20" Foreground="#E8EDF5">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Padding" Value="10,6" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#222833" />
            <Setter Property="Foreground" Value="#E8EDF5" />
            <Setter Property="BorderBrush" Value="#4A5970" />
        </Style>
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="#202630" />
            <Setter Property="BorderBrush" Value="#4A5970" />
            <Setter Property="Foreground" Value="#E8EDF5" />
        </Style>
    </Window.Resources>

    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Expedition Simulation Inspector" FontSize="24" FontWeight="SemiBold" />
            <TextBlock Margin="0,4,0,12" Foreground="#AFC0D7"
                       Text="Entwicklerwerkzeug: dieselbe JSON- und Simulationsschicht wie das Spiel. Keine Unity-Ansicht, keine zweite Regelimplementierung." />
            <WrapPanel Margin="0,0,0,8">
                <ComboBox x:Name="ScenarioSelector" Width="370" Height="31" Margin="0,0,8,0" DisplayMemberPath="DisplayName" />
                <Button Content="Szenario laden" Click="LoadSelectedScenario" />
                <Button Content="Datei laden…" Click="LoadScenarioFile" />
                <Button Content="Run-Record laden…" Click="LoadRunRecord" />
                <Button Content="Nächster Skriptbefehl (optional)" Click="ExecuteNextCommand" />
                <Button Content="Skriptpfad ausführen (optional)" Click="RunRemainingCommands" />
            </WrapPanel>
            <WrapPanel Margin="0,0,0,10">
                <Button Content="1 Tag fortschreiben" Click="AdvanceOneDay" />
                <TextBlock VerticalAlignment="Center" Text="Tage:" Margin="4,0,5,0" />
                <TextBox x:Name="FastForwardDays" Width="52" Height="29" Text="3" Margin="0,0,8,0" />
                <Button Content="Fortschreiben" Click="AdvanceSpecifiedDays" />
                <Button Content="Skript-Run speichern…" Click="SaveScriptedRun" />
            </WrapPanel>
            <Border BorderBrush="#4A5970" BorderThickness="1" Background="#202630" Padding="10" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.4*" />
                        <ColumnDefinition Width="1.2*" />
                        <ColumnDefinition Width="1.2*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,14,0">
                        <TextBlock Text="Zweck und Startwissen" FontWeight="SemiBold" />
                        <TextBlock x:Name="ScenarioPurpose" TextWrapping="Wrap" Foreground="#AFC0D7" Margin="0,3,0,0" />
                        <TextBlock x:Name="ScenarioStartingKnowledge" TextWrapping="Wrap" Foreground="#AFC0D7" Margin="0,3,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,14,0">
                        <TextBlock Text="Ausgewähltes Team" FontWeight="SemiBold" />
                        <TextBlock x:Name="ScenarioSelectedTeam" TextWrapping="Wrap" Foreground="#AFC0D7" Margin="0,3,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Erwarteter Prozess / Entscheidung" FontWeight="SemiBold" />
                        <TextBlock x:Name="ScenarioExpectedProcess" TextWrapping="Wrap" Foreground="#AFC0D7" Margin="0,3,0,0" />
                        <TextBlock x:Name="ScenarioDecisionPoint" TextWrapping="Wrap" Foreground="#AFC0D7" Margin="0,3,0,0" />
                    </StackPanel>
                </Grid>
            </Border>
            <TextBox x:Name="SessionStatus" IsReadOnly="True" TextWrapping="Wrap" MinHeight="48" Padding="8" Margin="0,0,0,12" />
        </StackPanel>

        <TabControl x:Name="InspectorTabs" Background="#202630" BorderBrush="#4A5970">
            <TabItem Header="Spielerwissen">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.15*" />
                        <ColumnDefinition Width="1.35*" />
                        <ColumnDefinition Width="1.5*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="Expedition und gesichertes Wissen" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <ListBox x:Name="PlayerStateList" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,10,0">
                        <TextBlock Text="Berichte, Hinweise und Belege" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <ListBox x:Name="PlayerReportsList" Height="150" DisplayMemberPath="DisplayName"
                                 SelectionChanged="PlayerReportSelectionChanged" />
                        <Border x:Name="PlayerReportDetails" BorderBrush="#4A5970" BorderThickness="1"
                                Background="#222833" Padding="10" Margin="0,8,0,0" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock x:Name="PlayerReportTitle" FontWeight="SemiBold" FontSize="16" TextWrapping="Wrap" />
                                <TextBlock x:Name="PlayerReportMeta" Foreground="#AFC0D7" Margin="0,3,0,8" TextWrapping="Wrap" />
                                <TextBlock x:Name="PlayerReportBody" TextWrapping="Wrap" />
                                <TextBlock x:Name="PlayerReportStructuredDetails" Foreground="#AFC0D7"
                                           Margin="0,8,0,0" TextWrapping="Wrap" />
                                <Button x:Name="ContinueToPlayerReportButton" Content="Weiter" HorizontalAlignment="Left"
                                        Margin="0,10,0,0" Click="ContinueToPlayerReport" Visibility="Collapsed" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Ortsbefehle und bekannte Optionen" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <ListBox Grid.Row="1" x:Name="PlayerOptionsList" SelectionChanged="PlayerOptionsSelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="2">
                                        <TextBlock Text="{Binding LocationName}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Label}" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding AvailabilityText}" Foreground="#AFC0D7" TextWrapping="Wrap" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <StackPanel Grid.Row="2" Margin="0,8,0,4">
                            <TextBlock x:Name="SelectedLocationCommandDetails" TextWrapping="Wrap" Foreground="#AFC0D7" />
                            <WrapPanel Margin="0,6,0,0">
                                <TextBlock Text="Scout für Umgebung:" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <ComboBox x:Name="AvailableScoutSelector" Width="160" DisplayMemberPath="DisplayName" Margin="0,0,8,0" />
                                <Button x:Name="ExecuteLocationCommandButton" Content="Ausgewählten Befehl ausführen" Click="ExecuteSelectedLocationCommand" IsEnabled="False" />
                            </WrapPanel>
                        </StackPanel>
                        <TextBlock Grid.Row="3" Text="Skriptbefehle sind nur ein optionaler reproduzierbarer Testpfad; Ortsbefehle werden hier direkt über die gemeinsame App-Schicht ausgeführt."
                                   TextWrapping="Wrap" Foreground="#AFC0D7" Margin="0,4,0,0" />
                    </Grid>
                </Grid>
            </TabItem>
            <TabItem Header="Bewegung">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.1*" />
                        <ColumnDefinition Width="1.4*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,18,0">
                        <TextBlock Text="Angrenzendes Hex betreten" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <TextBlock Text="Jede Taste sendet genau einen gewöhnlichen MoveExpeditionCommand. Kosten, Hindernisse und Kartenwissen stammen aus der gemeinsamen Simulation."
                                   TextWrapping="Wrap" Foreground="#AFC0D7" Margin="0,0,0,14" />
                        <Grid Width="330" HorizontalAlignment="Left">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Row="0" Grid.Column="0" Content="Nordwest" Tag="NorthWest" Click="MoveExpeditionDirection" />
                            <Button Grid.Row="0" Grid.Column="2" Content="Nordost" Tag="NorthEast" Click="MoveExpeditionDirection" />
                            <Button Grid.Row="1" Grid.Column="0" Content="West" Tag="West" Click="MoveExpeditionDirection" />
                            <Border Grid.Row="1" Grid.Column="1" BorderBrush="#4A5970" BorderThickness="1" Padding="8" Margin="0,0,8,0">
                                <TextBlock Text="Expedition" HorizontalAlignment="Center" />
                            </Border>
                            <Button Grid.Row="1" Grid.Column="2" Content="Ost" Tag="East" Click="MoveExpeditionDirection" />
                            <Button Grid.Row="2" Grid.Column="0" Content="Südwest" Tag="SouthWest" Click="MoveExpeditionDirection" />
                            <Button Grid.Row="2" Grid.Column="2" Content="Südost" Tag="SouthEast" Click="MoveExpeditionDirection" />
                        </Grid>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Gemeinsamer Bewegungszustand" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <TextBlock x:Name="MovementStateText" TextWrapping="Wrap" Margin="0,0,0,10" />
                        <TextBlock Text="Letztes Ergebnis" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <TextBox x:Name="MovementResultText" IsReadOnly="True" TextWrapping="Wrap" MinHeight="72" Padding="8" />
                        <TextBlock Text="Nach einer Bewegung werden Ortsoptionen, Wissen, Weltansicht und Scout-Steuerung aus derselben Session neu abgefragt."
                                   TextWrapping="Wrap" Foreground="#AFC0D7" Margin="0,10,0,0" />
                    </StackPanel>
                </Grid>
            </TabItem>
            <TabItem Header="Richtungsscouts">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.05*" />
                        <ColumnDefinition Width="1.2*" />
                        <ColumnDefinition Width="1.5*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                        <TextBlock Text="Verfügbare Scouts" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <TextBlock Text="Ein oder zwei Scouts auswählen. Abwesende, verletzte oder bereits eingesetzte Personen werden nicht angeboten."
                                   TextWrapping="Wrap" Foreground="#AFC0D7" Margin="0,0,0,8" />
                        <ListBox x:Name="DirectionalScoutList" SelectionMode="Multiple" DisplayMemberPath="DisplayName"
                                 SelectionChanged="DirectionalScoutSelectionChanged" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,12,0">
                        <TextBlock Text="Missionsauftrag" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <TextBlock Text="Richtung" />
                        <ComboBox x:Name="ScoutDirectionSelector" Margin="0,3,0,8" SelectionChanged="DirectionalScoutParametersChanged" />
                        <TextBlock Text="Dauer" />
                        <ComboBox x:Name="ScoutDurationSelector" Margin="0,3,0,8" SelectionChanged="DirectionalScoutParametersChanged" />
                        <TextBlock Text="Fokus" />
                        <ComboBox x:Name="ScoutFocusSelector" Margin="0,3,0,8" SelectionChanged="DirectionalScoutParametersChanged" />
                        <TextBlock Text="Verhalten" />
                        <ComboBox x:Name="ScoutBehaviorSelector" Margin="0,3,0,10" SelectionChanged="DirectionalScoutParametersChanged" />
                        <TextBlock x:Name="DirectionalScoutOrderSummary" TextWrapping="Wrap" Foreground="#AFC0D7" Margin="0,0,0,8" />
                        <Button x:Name="SendDirectionalScoutButton" Content="Richtungsscout entsenden" Click="SendDirectionalScout" IsEnabled="False" />
                    </StackPanel>
                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Missionsstatus (aktiv, überfällig, verletzt, zurück)" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <ListBox Grid.Row="1" x:Name="DirectionalMissionList" />
                        <TextBlock Grid.Row="2" Text="Zurückgekehrte Richtungsberichte" FontWeight="SemiBold" Margin="0,10,0,6" />
                        <ListBox Grid.Row="3" x:Name="DirectionalReportList" />
                    </Grid>
                </Grid>
            </TabItem>
            <TabItem Header="Testteam zusammenstellen">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.05*" />
                        <ColumnDefinition Width="1.15*" />
                        <ColumnDefinition Width="1.5*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="Verfügbare Personen" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <TextBlock Text="Mehrfachauswahl. Verletzte oder abwesende Personen werden in der Vorschau nicht eingesetzt." TextWrapping="Wrap" Foreground="#AFC0D7" Margin="0,0,0,8" />
                        <ListBox x:Name="TestTeamMemberList" SelectionMode="Multiple" SelectionChanged="TestTeamSelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="2">
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Detail}" Foreground="#AFC0D7" TextWrapping="Wrap" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <WrapPanel Margin="0,8,0,0">
                            <Button Content="Alle verfügbaren" Click="SelectAllAvailableTestMembers" />
                            <Button Content="Aktive Expedition" Click="SelectActiveExpeditionTestMembers" />
                        </WrapPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,10,0">
                        <TextBlock Text="Testzusammenstellung" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <TextBlock x:Name="TestTeamSummary" TextWrapping="Wrap" Margin="0,0,0,10" />
                        <TextBlock Text="Diese Auswahl ist eine reine Vorschau. Sie verändert weder die aktive Expedition noch den Skriptpfad." TextWrapping="Wrap" Foreground="#AFC0D7" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Ortsoptionen mit diesem Testteam" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <TextBlock Text="Die Verfügbarkeit stammt aus der gleichen Game.App-Abfrage wie die Spielansicht. Gesperrte Optionen nennen nur bekannte Voraussetzungen." TextWrapping="Wrap" Foreground="#AFC0D7" Margin="0,0,0,8" />
                        <ListBox x:Name="TestTeamOptionsList">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="2">
                                        <TextBlock Text="{Binding LocationName}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Label}" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding AvailabilityText}" Foreground="#AFC0D7" TextWrapping="Wrap" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Grid>
            </TabItem>
            <TabItem Header="Weltwahrheit (schreibgeschützt)">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.25*" />
                        <ColumnDefinition Width="1.15*" />
                        <ColumnDefinition Width="1.35*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="Orte, Kontext und räumliche Beziehungen" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <ListBox x:Name="WorldLocationsList" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,10,0">
                        <TextBlock Text="Fraktionen und Beobachtung" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <ListBox x:Name="WorldFactionsList" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Prozesse, Trigger und Situationen" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <ListBox x:Name="WorldProcessesList" />
                    </StackPanel>
                </Grid>
            </TabItem>
            <TabItem Header="Kausalität und Zeitachse">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Trace-IDs und caused-by-Referenzen sind die Inspektionsprojektion der autoritativen Weltgeschichte; sie verändern die Session nicht."
                               Foreground="#AFC0D7" TextWrapping="Wrap" Margin="0,0,0,8" />
                    <ListBox Grid.Row="1" x:Name="CausalityList" />
                </Grid>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
