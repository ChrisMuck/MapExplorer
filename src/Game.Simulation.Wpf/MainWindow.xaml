<Window x:Class="Game.Simulation.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Expedition Simulation Inspector" Height="900" Width="1440" MinHeight="680" MinWidth="1024"
        Background="#171A20" Foreground="#E8EDF5">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Padding" Value="10,6" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#222833" />
            <Setter Property="Foreground" Value="#E8EDF5" />
            <Setter Property="BorderBrush" Value="#4A5970" />
        </Style>
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="#202630" />
            <Setter Property="BorderBrush" Value="#4A5970" />
            <Setter Property="Foreground" Value="#E8EDF5" />
        </Style>
    </Window.Resources>

    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Expedition Simulation Inspector" FontSize="24" FontWeight="SemiBold" />
            <TextBlock Margin="0,4,0,12" Foreground="#AFC0D7"
                       Text="Entwicklerwerkzeug: dieselbe JSON- und Simulationsschicht wie das Spiel. Keine Unity-Ansicht, keine zweite Regelimplementierung." />
            <WrapPanel Margin="0,0,0,8">
                <ComboBox x:Name="ScenarioSelector" Width="370" Height="31" Margin="0,0,8,0" DisplayMemberPath="DisplayName" />
                <Button Content="Szenario laden" Click="LoadSelectedScenario" />
                <Button Content="Datei laden…" Click="LoadScenarioFile" />
                <Button Content="Run-Record laden…" Click="LoadRunRecord" />
                <Button Content="Nächster Skriptbefehl" Click="ExecuteNextCommand" />
                <Button Content="Skript fertig ausführen" Click="RunRemainingCommands" />
            </WrapPanel>
            <WrapPanel Margin="0,0,0,10">
                <Button Content="1 Tag fortschreiben" Click="AdvanceOneDay" />
                <TextBlock VerticalAlignment="Center" Text="Tage:" Margin="4,0,5,0" />
                <TextBox x:Name="FastForwardDays" Width="52" Height="29" Text="3" Margin="0,0,8,0" />
                <Button Content="Fortschreiben" Click="AdvanceSpecifiedDays" />
                <Button Content="Skript-Run speichern…" Click="SaveScriptedRun" />
            </WrapPanel>
            <TextBox x:Name="SessionStatus" IsReadOnly="True" TextWrapping="Wrap" MinHeight="48" Padding="8" Margin="0,0,0,12" />
        </StackPanel>

        <TabControl x:Name="InspectorTabs" Background="#202630" BorderBrush="#4A5970">
            <TabItem Header="Spielerwissen">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.15*" />
                        <ColumnDefinition Width="1.35*" />
                        <ColumnDefinition Width="1.5*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="Expedition und gesichertes Wissen" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <ListBox x:Name="PlayerStateList" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,10,0">
                        <TextBlock Text="Berichte, Hinweise und Belege" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <ListBox x:Name="PlayerReportsList" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Bekannte Ortsoptionen (gemeinsamer App-Vertrag)" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <ListBox x:Name="PlayerOptionsList" />
                    </StackPanel>
                </Grid>
            </TabItem>
            <TabItem Header="Weltwahrheit (schreibgeschützt)">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.25*" />
                        <ColumnDefinition Width="1.15*" />
                        <ColumnDefinition Width="1.35*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="Orte, Kontext und räumliche Beziehungen" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <ListBox x:Name="WorldLocationsList" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,10,0">
                        <TextBlock Text="Fraktionen und Beobachtung" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <ListBox x:Name="WorldFactionsList" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Prozesse, Trigger und Situationen" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <ListBox x:Name="WorldProcessesList" />
                    </StackPanel>
                </Grid>
            </TabItem>
            <TabItem Header="Kausalität und Zeitachse">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Trace-IDs und caused-by-Referenzen sind die Inspektionsprojektion der autoritativen Weltgeschichte; sie verändern die Session nicht."
                               Foreground="#AFC0D7" TextWrapping="Wrap" Margin="0,0,0,8" />
                    <ListBox Grid.Row="1" x:Name="CausalityList" />
                </Grid>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
