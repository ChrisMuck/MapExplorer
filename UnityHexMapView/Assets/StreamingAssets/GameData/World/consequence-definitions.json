{
  "documentType": "consequence-definitions",
  "schemaVersion": 1,
  "items": [
    {
      "id": "consequence-grave-disturbed",
      "stages": [
        {
          "id": "rumours-spread",
          "delayDays": 2,
          "effects": [
            { "id": "grave-rumour", "kind": "addEvidence", "referenceId": "evidence-grave-disturbance-rumour" },
            { "id": "grave-warning", "kind": "createSituation", "referenceId": "situation-investigate-disturbance", "dueDays": 3 }
          ],
          "event": {
            "title": "Unruhe bei einer alten Grabstelle",
            "body": "Zwei Tage nach einem Eingriff erreichen die Expedition erste, widerspruechliche Geruechte aus der Umgebung."
          }
        },
        {
          "id": "local-pattern-changed",
          "delayDays": 5,
          "severity": "serious",
          "effects": [
            { "id": "grave-change", "kind": "addEvidence", "referenceId": "evidence-grave-disturbance-change" },
            { "id": "grave-attention", "kind": "escalateRelatedFactionAwareness", "suppressIfSituationResponseTags": [ "investigate", "prepare-response" ] }
          ],
          "event": {
            "title": "Die Umgebung reagiert",
            "body": "Erst spaeter werden veraenderte Wege und vorsichtige Bewegungen um den Ort sichtbar."
          }
        }
      ]
    },
    {
      "id": "consequence-route-restored",
      "stages": [
        {
          "id": "traffic-returns",
          "delayDays": 2,
          "effects": [
            { "id": "route-evidence", "kind": "addEvidence", "referenceId": "evidence-route-restored" },
            { "id": "route-open", "kind": "setTilePassability", "isBlocked": false },
            { "id": "route-follow-up", "kind": "raiseWorldTrigger", "referenceId": "route-traffic-observed", "actionTags": [ "route", "traffic" ] }
          ],
          "event": {
            "title": "Spuren auf der wiederhergestellten Route",
            "body": "Erst nach einigen Tagen zeigen frische Spuren, dass der veränderte Übergang auch von anderen bemerkt wurde."
          }
        }
      ]
    },
    {
      "id": "consequence-seal-broken",
      "stages": [
        {
          "id": "first-disturbance",
          "delayDays": 2,
          "effects": [
            { "id": "seal-evidence", "kind": "addEvidence", "referenceId": "evidence-seal-disturbance" },
            { "id": "seal-warning", "kind": "createSituation", "referenceId": "situation-investigate-opened-seal", "dueDays": 3 }
          ],
          "event": {
            "title": "Unruhe am geöffneten Verschluss",
            "body": "Erst nach einiger Zeit zeigen sich veränderte Spuren und eine Unruhe um den geöffneten Ort. Was sie verursacht, bleibt offen."
          }
        },
        {
          "id": "later-consequence",
          "delayDays": 5,
          "severity": "serious",
          "effects": [
            { "id": "seal-later-evidence", "kind": "addEvidence", "referenceId": "evidence-seal-consequence" },
            { "id": "seal-follow-up", "kind": "raiseWorldTrigger", "referenceId": "seal-disturbance-observed", "actionTags": [ "open", "hazard" ], "suppressIfSituationResponseTags": [ "contain", "investigate" ] }
          ],
          "event": {
            "title": "Etwas hat sich verändert",
            "body": "Die spätere Entwicklung bestätigt nur, dass der geöffnete Verschluss nicht folgenlos blieb. Die Expedition muss die Zeichen weiter deuten."
          }
        }
      ]
    }
  ]
}
