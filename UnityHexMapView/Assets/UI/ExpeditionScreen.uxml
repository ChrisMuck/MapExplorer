<?xml version="1.0" encoding="utf-8"?>
<!-- =====================================================================
     ExpeditionScreen.uxml  —  Layout 3a (Feldbuch, aufklappbares Panel)
     Struktur = HTML-Mockup. Karte selbst ist NICHT hier drin: die
     .map-area ist transparent, darunter liegt deine Weltkarte
     (eigene Kamera / RenderTexture / Tilemap). Dieses UIDocument ist
     ein Overlay.
     Ordne im Editor die USS zu und weise den Controller (UIDocument-GO) zu.
     ===================================================================== -->
<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="ExpeditionScreen.uss" />

    <ui:VisualElement class="screen">

        <!-- ======================= TOP BAR ======================= -->
        <ui:VisualElement class="topbar">
            <ui:VisualElement class="topbar__brand">
                <ui:VisualElement class="brand-dot" />
                <ui:Label text="EXPEDITION" class="brand-text sans" />
            </ui:VisualElement>
            <ui:VisualElement class="divider-v" />
            <ui:VisualElement class="days mono">
                <ui:Label name="value-expedition-day" text="Expedition · Tag 7" class="day" />
                <ui:Label name="value-world-day" text="Welt · Tag 12" class="day day--muted" />
            </ui:VisualElement>

            <ui:VisualElement class="spacer" />

            <ui:VisualElement class="stats">
                <ui:VisualElement class="stat">
                    <ui:Label text="VORRÄTE" class="stat__label" />
                    <ui:Label name="value-supplies" text="42" class="stat__value mono" />
                </ui:VisualElement>
                <ui:VisualElement class="stat">
                    <ui:Label text="MEDIZIN" class="stat__label" />
                    <ui:Label name="value-medicine" text="4" class="stat__value mono" />
                </ui:VisualElement>
                <ui:VisualElement class="stat">
                    <ui:Label text="MORAL" class="stat__label" />
                    <ui:Label name="value-morale" text="Stabil" class="stat__value--good" />
                </ui:VisualElement>
                <ui:VisualElement class="stat">
                    <ui:Label text="GRUPPE" class="stat__label" />
                    <ui:Label name="value-party" text="5" class="stat__value mono" />
                </ui:VisualElement>
                <ui:VisualElement class="stat">
                    <ui:Label text="FELDWISSEN" class="stat__label" />
                    <ui:Label name="value-field-knowledge" text="0" class="stat__value mono" />
                </ui:VisualElement>
                <ui:VisualElement class="stat">
                    <ui:Label text="WISSEN" class="stat__label" />
                    <ui:Label name="value-base-knowledge" text="0" class="stat__value mono" />
                </ui:VisualElement>
                <ui:VisualElement class="mp-box">
                    <ui:Label text="BEWEGUNG" class="stat__label" />
                    <ui:Label name="value-mp" text="2/4" class="mp-value mono" />
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement class="divider-v" />

            <ui:VisualElement class="alert" name="alert">
                <ui:Label text="⚠" class="alert__icon" />
                <ui:Label name="alert-text" text="Späher überfällig" class="alert__text" />
                <ui:Label name="alert-count" text="2" class="badge mono" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- ======================= BODY ======================= -->
        <ui:VisualElement class="body">

            <!-- LEFT CONTEXT PANEL -->
            <ui:VisualElement class="left-panel">
                <ui:Label text="AUSGEWÄHLTES FELD" class="section-label" />
                <ui:Label name="coord" text="Feld 14 / 08" class="coord mono" />
                <ui:VisualElement class="chip-row">
                    <ui:Label name="selected-knowledge" text="Gemeldet" class="chip chip--gold" />
                    <ui:Label name="selected-reliability" text="Verlässlichkeit: Mittel" class="chip" />
                </ui:VisualElement>
                <ui:Label name="selected-meta" text="Letzter Bericht — Expedition 1, Tag 5" class="meta mono" />
                <ui:VisualElement name="selected-location-card" class="location-card" style="display: none;">
                    <ui:VisualElement class="location-card__head">
                        <ui:Label name="selected-location-kind" text="ORT" class="section-label" />
                        <ui:Label name="selected-location-status" text="Untersucht" class="location-card__status mono" />
                    </ui:VisualElement>
                    <ui:Label name="selected-location-name" text="Markiertes Grab" class="location-card__title serif" />
                    <ui:Label name="selected-location-risk" text="Warnzeichen. Kann untersucht werden." class="location-card__body" />
                    <ui:Label name="selected-location-action" text="Aktion: Untersuchen" class="location-card__action" />
                </ui:VisualElement>
                <ui:VisualElement class="hr" />
                <ui:Label text="GEMELDETE ZEICHEN" class="section-label" />
                <ui:VisualElement class="sign-row">
                    <ui:Label text="—" class="dash" />
                    <ui:Label name="selected-sign-1" text="Drei geschnitzte Pfähle" />
                </ui:VisualElement>
                <ui:VisualElement class="sign-row">
                    <ui:Label text="—" class="dash" />
                    <ui:Label name="selected-sign-2" text="Rauch weiter östlich" />
                </ui:VisualElement>
                <ui:VisualElement class="note">
                    <ui:Label text="NOTIZ" class="note__label" />
                    <ui:Label name="selected-note" text="„Mögliche Grenze der Grenzwächter. Mit großer Gruppe meiden.“" class="note__text serif" />
                </ui:VisualElement>
                <!-- Klick öffnet Berichte-Panel -->
                <ui:VisualElement class="linkrow" name="link-reports">
                    <ui:Label text="✦" class="ico" />
                    <ui:Label text="Verknüpft: „Rauch hinter dem Kamm“" class="linkrow__text" />
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- MAP AREA (transparent overlay über der Weltkarte) -->
            <ui:VisualElement class="map-area">
                <ui:VisualElement name="compass-rose" class="compass-rose">
                    <ui:VisualElement class="compass-ring" />
                    <ui:VisualElement class="compass-spoke compass-spoke--vertical" />
                    <ui:VisualElement class="compass-spoke compass-spoke--horizontal" />
                    <ui:VisualElement class="compass-spoke compass-spoke--diagonal-a" />
                    <ui:VisualElement class="compass-spoke compass-spoke--diagonal-b" />
                    <ui:VisualElement class="compass-center" />
                    <ui:Label name="compass-label-north" text="N" class="compass-label compass-label--n mono" />
                    <ui:Label name="compass-label-north-east" text="NO" class="compass-label compass-label--ne mono" />
                    <ui:Label name="compass-label-east" text="O" class="compass-label compass-label--e mono" />
                    <ui:Label name="compass-label-south-east" text="SO" class="compass-label compass-label--se mono" />
                    <ui:Label name="compass-label-south" text="S" class="compass-label compass-label--s mono" />
                    <ui:Label name="compass-label-south-west" text="SW" class="compass-label compass-label--sw mono" />
                    <ui:Label name="compass-label-west" text="W" class="compass-label compass-label--w mono" />
                    <ui:Label name="compass-label-north-west" text="NW" class="compass-label compass-label--nw mono" />
                </ui:VisualElement>

                <!-- DOCKED SIDE PANEL (3a) -->
                <ui:VisualElement class="side-panel" name="side-panel">
                    <ui:VisualElement class="side-panel__header">
                        <ui:VisualElement class="side-panel__title-wrap">
                            <ui:VisualElement class="title-dot" />
                            <ui:Label name="side-panel-title" text="Berichte" class="side-panel__title sans" />
                        </ui:VisualElement>
                        <ui:Label text="»" class="side-panel__close" name="side-panel-close" tooltip="Einklappen" />
                    </ui:VisualElement>

                    <ui:ScrollView class="side-panel__body">

                        <!-- BERICHTE -->
                        <ui:VisualElement class="section" name="section-reports">
                            <ui:VisualElement style="flex-direction: row; justify-content: space-between; align-items: center; margin-bottom: 13px;">
                                <ui:Label text="BERICHTE" class="section-label" />
                                <ui:Label name="report-count-label" text="0" style="font-size: 13px; color: rgb(240,207,122);" />
                            </ui:VisualElement>
                            <ui:VisualElement name="report-list" class="report-list" />
                            <ui:VisualElement name="report-card-main" class="card" style="display: none;">
                                <ui:VisualElement class="card__head">
                                    <ui:VisualElement class="avatar" />
                                    <ui:VisualElement style="flex-grow: 1;">
                                        <ui:Label name="report-title-main" text="Rauch hinter dem Kamm" class="card__title serif" />
                                        <ui:Label name="report-sub-main" text="Mara · Späher · Tag 5" class="card__sub mono" />
                                    </ui:VisualElement>
                                    <ui:VisualElement class="unread-dot" />
                                </ui:VisualElement>
                                <ui:VisualElement class="tag-row">
                                    <ui:Label name="report-reliability-main" text="Verlässlichkeit: Mittel" class="tag tag--gold" />
                                    <ui:Label name="report-direction-main" text="Nordost" class="tag" />
                                </ui:VisualElement>
                                <ui:Label name="report-excerpt-main" text="„Mara folgte dem Fluss zwei Tage nach Nordosten. Hinter dem zweiten Kamm fand sie drei geschnitzte Pfähle…“" class="excerpt serif" />
                                <ui:VisualElement name="report-hint-list" class="hint-list" />
                                <ui:VisualElement class="card__actions">
                                    <ui:Label name="action-open-report" text="Öffnen" class="btn--primary" style="flex-grow: 1; -unity-text-align: middle-center; margin-right: 8px;" />
                                    <ui:Label name="action-marker-from-report" text="Marker" class="btn" />
                                </ui:VisualElement>
                            </ui:VisualElement>
                            <ui:VisualElement name="report-card-secondary" class="card card--plain" style="display: none;">
                                <ui:VisualElement class="card__head" style="margin-bottom: 7px;">
                                    <ui:VisualElement class="avatar" style="width: 30px; height: 30px;" />
                                    <ui:VisualElement style="flex-grow: 1;">
                                        <ui:Label text="Verlassenes Lager" class="card__title serif" style="font-size: 14px;" />
                                        <ui:Label text="Jonas · Späher · Tag 4" class="card__sub mono" />
                                    </ui:VisualElement>
                                </ui:VisualElement>
                                <ui:VisualElement class="tag-row" style="margin-bottom: 0;">
                                    <ui:Label text="Verlässlichkeit: Hoch" class="tag tag--good" />
                                </ui:VisualElement>
                            </ui:VisualElement>
                        </ui:VisualElement>

                        <!-- TRUPP -->
                        <ui:VisualElement class="section" name="section-expedition">
                            <ui:Label text="TRUPP · 5 MITGLIEDER" class="section-label" style="margin-bottom: 9px;" />
                            <ui:VisualElement class="roster-row" style="background-color: rgb(38,45,36); border-width: 0;">
                                <ui:VisualElement class="avatar" style="width: 36px; height: 36px;" />
                                <ui:VisualElement style="flex-grow: 1;">
                                    <ui:Label text="Mara ★" class="name serif" />
                                    <ui:Label text="Späherin" class="role" />
                                </ui:VisualElement>
                                <ui:Label text="Auf Mission" class="status-pill status-pill--mission" />
                            </ui:VisualElement>
                            <ui:VisualElement class="roster-row">
                                <ui:VisualElement class="avatar" style="width: 36px; height: 36px;" />
                                <ui:VisualElement style="flex-grow: 1;">
                                    <ui:Label text="Jonas ★" class="name serif" />
                                    <ui:Label text="Späher" class="role" />
                                </ui:VisualElement>
                                <ui:Label text="Bereit" class="status-pill status-pill--ready" />
                            </ui:VisualElement>
                            <ui:VisualElement class="roster-row">
                                <ui:VisualElement class="avatar" style="width: 36px; height: 36px;" />
                                <ui:VisualElement style="flex-grow: 1;">
                                    <ui:Label text="Bren" class="name serif" />
                                    <ui:Label text="Soldat" class="role" />
                                </ui:VisualElement>
                                <ui:Label text="Gesund" class="status-good" />
                            </ui:VisualElement>
                            <ui:VisualElement class="roster-row">
                                <ui:VisualElement class="avatar" style="width: 36px; height: 36px;" />
                                <ui:VisualElement style="flex-grow: 1;">
                                    <ui:Label text="Elin" class="name serif" />
                                    <ui:Label text="Medic" class="role" />
                                </ui:VisualElement>
                                <ui:Label text="Gesund" class="status-good" />
                            </ui:VisualElement>
                        </ui:VisualElement>

                        <!-- SPÄHER -->
                        <ui:VisualElement class="section" name="section-scouts">
                            <ui:Label text="AKTIVE MISSION" class="section-label" style="margin-bottom: 13px;" />
                            <ui:VisualElement class="card" style="border-color: rgba(127,160,196,0.28);">
                                <ui:VisualElement class="card__head" style="margin-bottom: 11px;">
                                    <ui:Label text="✦" style="color: rgb(127,160,196); font-size: 16px; margin-right: 8px;" />
                                    <ui:Label text="Mara" class="card__title serif" style="font-size: 16px; flex-grow: 1;" />
                                    <ui:Label text="Auf Mission" class="status-pill status-pill--mission" />
                                </ui:VisualElement>
                                <ui:VisualElement style="flex-direction: row; margin-bottom: 6px;"><ui:Label text="Richtung" style="width: 110px; color: rgb(190,184,169); font-size: 13px; -unity-font-style: bold;" /><ui:Label text="Nordost" style="font-size: 13px; color: rgb(232,227,214);" /></ui:VisualElement>
                                <ui:VisualElement style="flex-direction: row; margin-bottom: 6px;"><ui:Label text="Fokus" style="width: 110px; color: rgb(190,184,169); font-size: 13px; -unity-font-style: bold;" /><ui:Label text="Fraktionsspuren" style="font-size: 13px; color: rgb(232,227,214);" /></ui:VisualElement>
                                <ui:VisualElement style="flex-direction: row; margin-bottom: 6px;"><ui:Label text="Verhalten" style="width: 110px; color: rgb(190,184,169); font-size: 13px; -unity-font-style: bold;" /><ui:Label text="Vorsichtig" style="font-size: 13px; color: rgb(232,227,214);" /></ui:VisualElement>
                                <ui:VisualElement style="flex-direction: row;"><ui:Label text="Zurück erwartet" style="width: 110px; color: rgb(190,184,169); font-size: 13px; -unity-font-style: bold;" /><ui:Label text="Tag 6 · überfällig" style="font-size: 13px; color: rgb(240,194,178);" /></ui:VisualElement>
                            </ui:VisualElement>
                            <ui:Label text="BEREIT" class="section-label" style="margin-bottom: 9px; margin-top: 4px;" />
                            <ui:VisualElement class="roster-row">
                                <ui:Label text="✦" style="color: rgb(127,160,196); margin-right: 10px;" />
                                <ui:Label text="Jonas" class="name serif" style="flex-grow: 1;" />
                                <ui:Label text="Bereit" class="status-good" />
                            </ui:VisualElement>
                            <ui:Label name="action-send-scout-panel" text="＋ Späher senden" class="btn--primary" style="-unity-text-align: middle-center; margin-top: 4px;" />
                        </ui:VisualElement>

                        <!-- JOURNAL -->
                        <ui:VisualElement class="section" name="section-journal">
                            <ui:Label text="EXPEDITIONS-TAGEBUCH" class="section-label" style="margin-bottom: 14px;" />
                            <ui:VisualElement style="border-left-width: 1px; border-left-color: rgba(240,207,122,0.25); padding-left: 16px; margin-left: 5px; margin-bottom: 16px;">
                                <ui:Label text="TAG 5" class="mono" style="font-size: 12px; color: rgb(240,207,122);" />
                                <ui:Label text="Mara kehrte mit einem Bericht über Rauch im Nordosten zurück." class="serif" style="font-size: 14px; color: rgb(232,227,214); white-space: normal; margin-top: 2px;" />
                            </ui:VisualElement>
                            <ui:VisualElement style="border-left-width: 1px; border-left-color: rgba(255,255,255,0.1); padding-left: 16px; margin-left: 5px; margin-bottom: 16px;">
                                <ui:Label text="TAG 4" class="mono" style="font-size: 12px; color: rgb(190,184,169);" />
                                <ui:Label text="Verlassenes Lager am Flussufer entdeckt. Keine Spuren." class="serif" style="font-size: 14px; color: rgb(201,195,180); white-space: normal; margin-top: 2px;" />
                            </ui:VisualElement>
                            <ui:VisualElement style="border-left-width: 1px; border-left-color: rgba(255,255,255,0.1); padding-left: 16px; margin-left: 5px;">
                                <ui:Label text="TAG 3" class="mono" style="font-size: 12px; color: rgb(190,184,169);" />
                                <ui:Label text="Jonas und Mara zu getrennten Aufklärungen ausgesandt." class="serif" style="font-size: 14px; color: rgb(201,195,180); white-space: normal; margin-top: 2px;" />
                            </ui:VisualElement>
                        </ui:VisualElement>

                        <!-- ARCHIV -->
                        <ui:VisualElement class="section" name="section-archive">
                            <ui:Label text="GESICHERTES WISSEN" class="section-label" style="margin-bottom: 11px;" />
                            <ui:VisualElement name="archive-list" />
                            <ui:VisualElement class="card" style="flex-direction: row; padding: 12px;">
                                <ui:VisualElement class="avatar" style="width: 46px; height: 46px;" />
                                <ui:VisualElement style="flex-grow: 1;">
                                    <ui:Label text="Markiertes Grab" class="card__title serif" />
                                    <ui:Label text="Besonderer Ort · Entdeckt" class="card__sub" style="font-size: 13px; margin-top: 2px;" />
                                    <ui:Label text="2 Berichte · 1 Notiz" class="mono" style="font-size: 12px; color: rgb(190,184,169); margin-top: 4px;" />
                                </ui:VisualElement>
                            </ui:VisualElement>
                            <ui:VisualElement class="card card--plain" style="flex-direction: row; padding: 12px;">
                                <ui:VisualElement class="avatar" style="width: 46px; height: 46px;" />
                                <ui:VisualElement style="flex-grow: 1;">
                                    <ui:Label text="Grenzmarkierungen" class="card__title serif" style="color: rgb(232,227,214);" />
                                    <ui:Label text="Warnzeichen · Gemeldet" class="card__sub" style="font-size: 13px; margin-top: 2px;" />
                                </ui:VisualElement>
                            </ui:VisualElement>
                        </ui:VisualElement>

                    </ui:ScrollView>
                </ui:VisualElement>

                <!-- RIGHT MENU RAIL -->
                <ui:VisualElement class="rail">
                    <ui:VisualElement class="rail-btn" name="rail-expedition" style="display: none;">
                        <ui:VisualElement class="active-bar" />
                        <ui:Label text="Ex" class="rail-btn__icon sans" />
                        <ui:Label text="Trupp" class="rail-btn__label" />
                    </ui:VisualElement>
                    <ui:VisualElement class="rail-btn" name="rail-scouts">
                        <ui:VisualElement class="active-bar" />
                        <ui:Label text="✦" class="rail-btn__icon rail-btn__icon--scout" />
                        <ui:Label text="Späher" class="rail-btn__label" />
                    </ui:VisualElement>
                    <ui:VisualElement class="rail-btn" name="rail-reports">
                        <ui:VisualElement class="active-bar" />
                        <ui:VisualElement style="position: relative;">
                            <ui:Label text="Be" class="rail-btn__icon rail-btn__icon--gold sans" />
                        </ui:VisualElement>
                        <ui:Label name="report-count-rail" text="0" class="rail-badge mono" />
                        <ui:Label text="Berichte" class="rail-btn__label rail-btn__label--gold" />
                    </ui:VisualElement>
                    <ui:VisualElement class="rail-btn" name="rail-journal">
                        <ui:VisualElement class="active-bar" />
                        <ui:Label text="Jo" class="rail-btn__icon sans" />
                        <ui:Label text="Journal" class="rail-btn__label" />
                    </ui:VisualElement>
                    <ui:VisualElement class="rail-btn" name="rail-archive">
                        <ui:VisualElement class="active-bar" />
                        <ui:Label text="Ar" class="rail-btn__icon sans" />
                        <ui:Label text="Archiv" class="rail-btn__label" />
                    </ui:VisualElement>
                </ui:VisualElement>

            </ui:VisualElement>
        </ui:VisualElement>

        <!-- ======================= EVENT POPUP ======================= -->
        <ui:VisualElement name="event-popup" class="event-popup" style="display: none;">
            <ui:VisualElement class="event-card">
                <ui:VisualElement class="event-image" />
                <ui:VisualElement class="event-content">
                    <ui:Label name="event-source" text="Expedition" class="section-label" />
                    <ui:Label name="event-title" text="Ereignis" class="event-title serif" />
                    <ui:Label name="event-body" text="Ein Ereignis wartet auf Entscheidung." class="event-body serif" />
                    <ui:VisualElement name="event-options" class="event-options" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- ======================= LOCATION INTERACTION POPUP ======================= -->
        <ui:VisualElement name="location-interaction-popup" class="bi-root" style="display: none;">
            <ui:VisualElement class="bi-popup">
                <ui:VisualElement class="bi-header">
                    <ui:VisualElement class="bi-icon">
                        <ui:Label name="location-icon-glyph" text="~" class="bi-icon-glyph" />
                    </ui:VisualElement>
                    <ui:VisualElement class="bi-header-main">
                        <ui:VisualElement class="bi-kicker-row">
                            <ui:Label name="location-eyebrow" text="FUNDSTELLE" class="bi-eyebrow mono" />
                            <ui:Label text="•" class="bi-muted mono" />
                            <ui:Label name="location-anchor" text="Feld 00/00" class="bi-anchor mono" />
                        </ui:VisualElement>
                        <ui:Label name="location-title" text="Fundstelle" class="bi-title serif" />
                        <ui:Label name="location-subtitle" text="Archetyp · Variante" class="bi-subtitle mono" />
                        <ui:VisualElement class="bi-state-row">
                            <ui:Label name="state-knowledge" text="Wissensstand: Bestaetigt" class="bi-state-pill" />
                            <ui:Label name="state-operational" text="Zustand: Unklar" class="bi-state-pill bi-state-pill--alert" />
                            <ui:Label name="state-presence" text="Anwesenheit: Unklar" class="bi-state-pill" />
                        </ui:VisualElement>
                        <ui:VisualElement name="modifier-row" class="bi-modifier-row" />
                    </ui:VisualElement>
                    <ui:Label name="btn-close" text="X" class="bi-close" />
                </ui:VisualElement>

                <ui:VisualElement class="bi-flavor-band">
                    <ui:Label name="location-flavor" text="Die Expedition steht vor einer Entscheidung." class="bi-flavor serif" />
                </ui:VisualElement>

                <ui:VisualElement name="view-actions" class="bi-body">
                    <ui:VisualElement class="bi-action-column">
                        <ui:Label text="VERFUEGBARE AKTIONEN" class="bi-section-label mono" />
                        <ui:VisualElement name="action-list" class="bi-action-list" />
                    </ui:VisualElement>
                    <ui:VisualElement name="detail-panel" class="bi-detail-panel" />
                </ui:VisualElement>

                <ui:VisualElement name="view-outcome" class="bi-outcome-view" style="display: none;">
                    <ui:Label name="outcome-tier" text="Ergebnis" class="bi-outcome-tier serif" />
                    <ui:Label name="outcome-caption" text="Die Aktion wurde ausgefuehrt." class="bi-outcome-caption" />
                    <ui:VisualElement name="outcome-effects" class="bi-effect-list" />
                    <ui:Label name="btn-back-from-outcome" text="Zurueck zu den Aktionen" class="bi-secondary-button" />
                </ui:VisualElement>

                <ui:VisualElement name="view-project" class="bi-project-view" style="display: none;">
                    <ui:Label name="project-title" text="Projekt" class="bi-outcome-tier serif" />
                    <ui:Label name="project-day-label" text="Fortschritt 0/0" class="bi-outcome-caption" />
                    <ui:VisualElement class="bi-progress-track">
                        <ui:VisualElement name="project-progress-fill" class="bi-progress-fill" />
                    </ui:VisualElement>
                    <ui:VisualElement name="project-effects" class="bi-effect-list" />
                    <ui:VisualElement class="bi-project-actions">
                        <ui:Label name="btn-advance-project" text="Projekttag investieren" class="bi-primary-button" />
                        <ui:Label name="btn-back-from-project" text="Zurueck zu den Aktionen" class="bi-secondary-button" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- ======================= SCOUT MISSION MODAL ======================= -->
        <ui:VisualElement name="scout-mission-popup" class="scout-popup" style="display: none;">
            <ui:VisualElement class="scout-modal">
                <ui:VisualElement class="scout-modal__header">
                    <ui:Label text="SPAEHER AUSSENDEN" class="section-label" />
                    <ui:Label name="scout-modal-summary" text="Mission vorbereiten" class="mono scout-modal__summary" />
                    <ui:Label name="scout-modal-close" text="X" class="faction-modal__close" />
                </ui:VisualElement>
                <ui:VisualElement class="scout-modal__body">
                    <ui:VisualElement class="scout-modal__column scout-modal__column--list">
                        <ui:Label text="VERFUEGBARE SPAEHER" class="section-label" />
                        <ui:VisualElement name="scout-candidate-list" class="scout-candidate-list" />
                    </ui:VisualElement>
                    <ui:VisualElement class="scout-modal__column scout-modal__column--orders">
                        <ui:Label text="RICHTUNG" class="section-label" />
                        <ui:VisualElement class="scout-option-row">
                            <ui:Label name="scout-direction-north" text="Nord" class="scout-choice" />
                            <ui:Label name="scout-direction-north-east" text="Nordost" class="scout-choice" />
                            <ui:Label name="scout-direction-east" text="Ost" class="scout-choice" />
                            <ui:Label name="scout-direction-south-east" text="Suedost" class="scout-choice" />
                            <ui:Label name="scout-direction-south" text="Sued" class="scout-choice" />
                            <ui:Label name="scout-direction-south-west" text="Suedwest" class="scout-choice" />
                            <ui:Label name="scout-direction-west" text="West" class="scout-choice" />
                            <ui:Label name="scout-direction-north-west" text="Nordwest" class="scout-choice" />
                        </ui:VisualElement>
                        <ui:Label text="DAUER" class="section-label scout-modal__section" />
                        <ui:VisualElement class="scout-option-row">
                            <ui:Label name="scout-duration-1" text="1 Tag" class="scout-choice" />
                            <ui:Label name="scout-duration-2" text="2 Tage" class="scout-choice" />
                            <ui:Label name="scout-duration-3" text="3 Tage" class="scout-choice" />
                            <ui:Label name="scout-duration-4" text="4 Tage" class="scout-choice" />
                            <ui:Label name="scout-duration-5" text="5 Tage" class="scout-choice" />
                        </ui:VisualElement>
                        <ui:Label text="FOKUS" class="section-label scout-modal__section" />
                        <ui:VisualElement class="scout-option-row">
                            <ui:Label name="scout-focus-survey" text="Erkunden" class="scout-choice" />
                            <ui:Label name="scout-focus-route" text="Route" class="scout-choice" />
                            <ui:Label name="scout-focus-resources" text="Ressourcen" class="scout-choice" />
                            <ui:Label name="scout-focus-faction" text="Zeichen" class="scout-choice" />
                            <ui:Label name="scout-focus-ruins" text="Ruinen" class="scout-choice" />
                        </ui:VisualElement>
                        <ui:Label text="VERHALTEN" class="section-label scout-modal__section" />
                        <ui:VisualElement class="scout-option-row">
                            <ui:Label name="scout-behavior-cautious" text="Vorsichtig" class="scout-choice" />
                            <ui:Label name="scout-behavior-balanced" text="Ausgewogen" class="scout-choice" />
                            <ui:Label name="scout-behavior-bold" text="Riskant" class="scout-choice" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="scout-modal__footer">
                    <ui:Label name="scout-mission-preview" text="Waehle mindestens einen verfuegbaren Spaeher." class="scout-preview" />
                    <ui:Label name="scout-mission-send" text="Mission starten" class="btn--primary" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- ======================= FACTION CONTACT MODAL ======================= -->
        <ui:VisualElement name="faction-contact-popup" class="faction-popup" style="display: none;">
            <ui:VisualElement class="faction-modal">
                <ui:VisualElement class="faction-modal__header">
                    <ui:Label name="faction-modal-title" text="KONTAKT" class="section-label" />
                    <ui:Label name="faction-modal-coord" text="Feld 00 / 00" class="mono faction-modal__coord" />
                    <ui:Label name="faction-modal-close" text="X" class="faction-modal__close" />
                </ui:VisualElement>
                <ui:VisualElement class="faction-modal__body">
                    <ui:VisualElement class="faction-modal__person">
                        <ui:VisualElement class="faction-portrait" />
                        <ui:Label name="faction-representative-name" text="Wächter" class="faction-name serif" />
                        <ui:Label name="faction-representative-role" text="Grenzwächter" class="faction-role" />
                        <ui:VisualElement class="hr" />
                        <ui:Label text="HALTUNG" class="section-label" />
                        <ui:Label name="faction-attitude" text="Wachsam" class="faction-attitude" />
                        <ui:Label name="faction-representative-description" text="Sie beobachtet euch genau." class="faction-description serif" />
                    </ui:VisualElement>
                    <ui:VisualElement class="faction-modal__conversation">
                        <ui:Label name="faction-dialogue-label" text="DIESE BEGEGNUNG" class="section-label faction-dialogue-label" />
                        <ui:Label name="faction-dialogue" text="Eine Fraktion wartet auf Antwort." class="faction-dialogue serif" />
                        <ui:VisualElement class="faction-response-list">
                            <ui:Label name="faction-response-info" text="Nach der Lage fragen" class="faction-response" />
                            <ui:Label name="faction-response-trade" text="Etwas erwerben wollen" class="faction-response" />
                            <ui:Label name="faction-response-leave" text="Sich verabschieden" class="faction-response faction-response--quiet" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement class="faction-modal__offers">
                        <ui:VisualElement class="faction-offer-head">
                            <ui:Label text="ANGEBOTE" class="section-label" />
                            <ui:Label name="faction-knowledge-value" text="Wissen: 0" class="mono faction-knowledge" />
                        </ui:VisualElement>
                        <ui:VisualElement name="faction-offer-list" class="faction-offer-list" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- ======================= ACTION BAR ======================= -->
        <ui:VisualElement class="action-bar">
            <ui:Label name="action-move" text="↳ Bewegen" class="btn" />
            <ui:Label name="action-inspect" text="⌕ Untersuchen" class="btn" />
            <ui:Label name="action-send-scout" text="✦ Späher senden" class="btn" />
            <ui:Label name="action-add-marker" text="△ Marker" class="btn" />
            <ui:Label name="action-add-note" text="✎ Notiz" class="btn" />
            <ui:Label name="action-camp" text="⛺ Lager" class="btn" />
            <ui:Label name="action-open-base" text="⌂ Basislager" class="btn" />
            <ui:VisualElement class="spacer" />
            <ui:Label name="action-return-base" text="Expedition abschließen" class="btn btn--ghost" />
            <ui:Label name="action-end-day" text="Tag beenden →" class="btn--primary" />
        </ui:VisualElement>

    </ui:VisualElement>
</ui:UXML>
