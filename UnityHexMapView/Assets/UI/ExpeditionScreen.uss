/* =====================================================================
   ExpeditionScreen.uss  —  UI Toolkit styles for layout 3a (Feldbuch)
   Farbwelt & Abstände 1:1 aus dem HTML-Mockup übernommen.
   Fonts: siehe README — .mono / .serif / .sans FontAssets zuweisen.
   ===================================================================== */

/* ---------- Root ---------- */
.screen {
    width: 100%;
    height: 100%;
    flex-grow: 1;
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0);
    color: rgb(232, 227, 214);                  /* #e8e3d6 */
    font-size: 15px;
}

/* ---------- Top bar ---------- */
.topbar {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 68px;
    flex-direction: row;
    align-items: center;
    padding-left: 20px;
    padding-right: 20px;
    background-color: rgb(23, 27, 24);          /* #171b18 */
    border-bottom-width: 1px;
    border-bottom-color: rgba(240, 207, 122, 0.16);
}
.topbar__brand {
    flex-direction: row; align-items: center;
    min-width: 184px; flex-shrink: 0;
}
.brand-dot {
    width: 8px; height: 8px; border-radius: 4px;
    background-color: rgb(143, 174, 116);       /* #8fae74 */
    margin-right: 9px;
}
.brand-text {
    font-size: 15px; letter-spacing: 2px;
    color: rgb(240, 207, 122); -unity-font-style: bold;
    white-space: nowrap; flex-shrink: 0;
}
.divider-v {
    width: 1px; height: 24px; margin-left: 20px; margin-right: 20px;
    background-color: rgba(255, 255, 255, 0.1);
}
.days { flex-direction: row; flex-shrink: 0; }
.days .day { margin-right: 22px; color: rgb(201, 195, 180); white-space: nowrap; flex-shrink: 0; font-size: 16px; }
.day--muted { color: rgb(185, 177, 158); }
.spacer { flex-grow: 1; }

.stats { flex-direction: row; align-items: center; flex-shrink: 0; }
.stat { align-items: flex-end; margin-left: 22px; min-width: 52px; flex-shrink: 0; }
.stat__label { font-size: 12px; letter-spacing: 1.2px; color: rgb(178, 170, 151); white-space: nowrap; -unity-font-style: bold; }
.stat__value { font-size: 18px; color: rgb(244, 237, 224); }
.stat__value--good { font-size: 16px; color: rgb(143, 174, 116); -unity-font-style: bold; }
.mp-box {
    flex-direction: row; align-items: center; margin-left: 20px;
    padding: 7px 12px; border-radius: 6px;
    border-width: 1px; border-color: rgba(240, 207, 122, 0.35);
    flex-shrink: 0;
}
.mp-box .stat__label { margin-right: 8px; color: rgb(190, 178, 145); }
.mp-value { font-size: 18px; color: rgb(240, 207, 122); }

.alert {
    flex-direction: row; align-items: center;
    padding: 7px 12px; border-radius: 6px;
    background-color: rgba(217, 122, 95, 0.12);
    border-width: 1px; border-color: rgba(217, 122, 95, 0.4);
    flex-shrink: 0;
}
.alert__icon { color: rgb(217, 122, 95); margin-right: 8px; }
.alert__text { font-size: 14px; color: rgb(232, 182, 167); }
.badge {
    margin-left: 8px; font-size: 12px; -unity-font-style: bold;
    background-color: rgb(217, 122, 95); color: rgb(29, 34, 30);
    border-radius: 8px; padding: 1px 6px;
}

/* ---------- Body ---------- */
.body {
    position: absolute;
    left: 0;
    right: 0;
    top: 68px;
    bottom: 76px;
    flex-direction: row;
}

/* Left context panel */
.left-panel {
    width: 360px; flex-shrink: 0;
    background-color: rgb(32, 38, 31);          /* #20261f */
    border-right-width: 1px; border-right-color: rgba(255, 255, 255, 0.06);
    padding: 24px;
}
.section-label { font-size: 12px; letter-spacing: 1.4px; color: rgb(185, 177, 158); -unity-font-style: bold; }
.coord { font-size: 30px; color: rgb(244, 237, 224); margin-top: 14px; }
.chip-row { flex-direction: row; margin-top: 10px; }
.chip {
    font-size: 14px; padding: 4px 10px; border-radius: 4px; margin-right: 8px;
    background-color: rgba(255, 255, 255, 0.05); color: rgb(201, 195, 180);
}
.chip--gold {
    border-width: 1px; border-color: rgba(240, 207, 122, 0.5);
    color: rgb(240, 207, 122); background-color: rgba(0,0,0,0);
}
.meta { font-size: 14px; color: rgb(190, 184, 169); margin-top: 10px; }
.location-card {
    margin-top: 13px;
    padding: 12px;
    border-radius: 7px;
    border-width: 1px;
    border-color: rgba(240, 207, 122, 0.24);
    background-color: rgb(38, 45, 36);
}
.location-card__head { flex-direction: row; justify-content: space-between; align-items: center; }
.location-card__status {
    font-size: 12px;
    color: rgb(240, 207, 122);
    padding: 2px 7px;
    border-radius: 10px;
    background-color: rgba(240, 207, 122, 0.1);
}
.location-card__title { margin-top: 8px; font-size: 20px; color: rgb(244, 237, 224); }
.location-card__body { margin-top: 6px; font-size: 14px; color: rgb(201, 195, 180); white-space: normal; }
.location-card__action {
    margin-top: 9px;
    font-size: 13px;
    color: rgb(143, 174, 116);
    -unity-font-style: bold;
}
.location-card__action:hover {
      color: rgb(183, 213, 146);
  }
.tutorial-brief-card {
    margin-top: 13px;
    padding: 12px;
    border-left-width: 2px;
    border-left-color: rgba(240, 207, 122, 0.68);
    background-color: rgba(240, 207, 122, 0.055);
}
.tutorial-brief-card__body {
    margin-top: 7px;
    color: rgb(216, 210, 196);
    font-size: 14px;
    line-height: 19px;
    white-space: normal;
}
.hr { height: 1px; background-color: rgba(255, 255, 255, 0.07); margin-top: 16px; margin-bottom: 16px; }
.sign-row { flex-direction: row; margin-top: 7px; color: rgb(216, 210, 196); }
.sign-row .dash { color: rgb(240, 207, 122); margin-right: 8px; }
.note {
    margin-top: 16px; background-color: rgb(233, 225, 204);      /* parchment */
    border-radius: 6px; padding: 14px 15px;
}
.note__label { font-size: 12px; letter-spacing: 1.4px; color: rgb(116, 99, 67); -unity-font-style: bold; }
.note__text {
    margin-top: 7px; font-size: 16px; color: rgb(58, 50, 37);
    -unity-font-style: italic; white-space: normal;
}
.linkrow {
    margin-top: 16px; flex-direction: row; align-items: center;
    padding: 10px 12px; border-radius: 6px;
    border-width: 1px; border-color: rgba(255, 255, 255, 0.08);
}
.linkrow .ico { color: rgb(127, 160, 196); margin-right: 8px; }
.linkrow__text { font-size: 14px; color: rgb(201, 195, 180); }

/* ---------- Map area (transparent — Weltkarte scheint durch) ---------- */
.map-area { flex-grow: 1; position: relative; }

.compass-rose {
    position: absolute;
    right: 112px;
    top: 18px;
    width: 118px;
    height: 118px;
    border-radius: 59px;
    background-color: rgba(18, 22, 19, 0.74);
    border-width: 1px;
    border-color: rgba(240, 207, 122, 0.26);
    opacity: 0.92;
}
.compass-ring {
    position: absolute;
    left: 15px;
    top: 15px;
    width: 88px;
    height: 88px;
    border-radius: 44px;
    border-width: 1px;
    border-color: rgba(232, 227, 214, 0.16);
}
.compass-spoke {
    position: absolute;
    left: 58px;
    top: 18px;
    width: 1px;
    height: 82px;
    background-color: rgba(232, 227, 214, 0.16);
}
.compass-spoke--horizontal {
    rotate: 90deg;
}
.compass-spoke--diagonal-a {
    rotate: 45deg;
    background-color: rgba(240, 207, 122, 0.12);
}
.compass-spoke--diagonal-b {
    rotate: -45deg;
    background-color: rgba(240, 207, 122, 0.12);
}
.compass-center {
    position: absolute;
    left: 55px;
    top: 55px;
    width: 8px;
    height: 8px;
    border-radius: 4px;
    background-color: rgb(240, 207, 122);
}
.compass-label {
    position: absolute;
    width: 30px;
    height: 18px;
    -unity-text-align: middle-center;
    font-size: 12px;
    color: rgb(232, 227, 214);
    -unity-font-style: bold;
}
.compass-label--n {
    left: 44px;
    top: 5px;
    color: rgb(240, 207, 122);
    font-size: 15px;
}
.compass-label--ne { left: 75px; top: 20px; }
.compass-label--e { left: 86px; top: 50px; }
.compass-label--se { left: 75px; top: 80px; }
.compass-label--s { left: 44px; top: 95px; }
.compass-label--sw { left: 13px; top: 80px; }
.compass-label--w { left: 2px; top: 50px; }
.compass-label--nw { left: 13px; top: 20px; }

/* Docked side panel (3a) */
.side-panel {
    display: none;
    position: absolute; top: 0; bottom: 0; right: 84px; width: 390px;
    background-color: rgb(32, 38, 31);
    border-left-width: 1px; border-left-color: rgba(255, 255, 255, 0.08);
    flex-direction: column;
    opacity: 1;
}
.side-panel.open { display: flex; }
.side-panel__header {
    flex-direction: row; align-items: center; justify-content: space-between;
    padding: 15px 18px; flex-shrink: 0;
    border-bottom-width: 1px; border-bottom-color: rgba(255, 255, 255, 0.08);
}
.side-panel__title-wrap { flex-direction: row; align-items: center; }
.title-dot { width: 7px; height: 7px; border-radius: 4px; background-color: rgb(240, 207, 122); margin-right: 10px; }
.side-panel__title { font-size: 18px; color: rgb(244, 237, 224); -unity-font-style: bold; }
.side-panel__close {
    width: 26px; height: 26px; border-radius: 6px; font-size: 15px;
    color: rgb(190, 184, 169);
    -unity-text-align: middle-center; align-items: center; justify-content: center;
}
.side-panel__close:hover { background-color: rgba(255, 255, 255, 0.06); }
.side-panel__body { padding: 20px; flex-grow: 1; }

/* section visibility — controller shows exactly one */
.section { display: none; }
.section.visible { display: flex; }

/* Right menu rail (stays put) */
.rail {
    position: absolute; top: 0; bottom: 0; right: 0; width: 84px;
    background-color: rgba(23, 27, 24, 0.94);
    border-left-width: 1px; border-left-color: rgba(240, 207, 122, 0.16);
    align-items: center; padding-top: 12px; padding-bottom: 12px;
}
.rail-btn {
    position: relative; width: 100%; padding-top: 8px; padding-bottom: 8px;
    align-items: center; margin-bottom: 6px;
}
.rail-btn:hover { background-color: rgba(255, 255, 255, 0.04); }
.rail-btn__icon {
    width: 42px; height: 42px; border-radius: 9px;
    align-items: center; justify-content: center; -unity-text-align: middle-center;
    background-color: rgba(255, 255, 255, 0.05);
    border-width: 1px; border-color: rgba(255, 255, 255, 0.1);
    color: rgb(201, 195, 180); font-size: 15px; -unity-font-style: bold;
}
.rail-btn__icon--gold {
    background-color: rgba(240, 207, 122, 0.14);
    border-color: rgba(240, 207, 122, 0.32); color: rgb(240, 207, 122);
}
.rail-btn__icon--scout { color: rgb(127, 160, 196); font-size: 18px; }
.rail-btn__label { font-size: 11px; letter-spacing: 0.3px; color: rgb(190, 184, 169); margin-top: 5px; -unity-font-style: bold; }
.rail-btn__label--gold { color: rgb(240, 207, 122); }
.rail-badge {
    position: absolute; top: 2px; right: 14px;
    font-size: 11px; -unity-font-style: bold;
    background-color: rgb(217, 122, 95); color: rgb(29, 34, 30);
    border-radius: 8px; padding: 0 5px;
}
.active-bar {
    display: none;
    position: absolute; left: 0; top: 6px; bottom: 6px; width: 3px;
    background-color: rgb(240, 207, 122); border-radius: 0 2px 2px 0;
}
.rail-btn.active .active-bar { display: flex; }

/* ---------- Cards used inside sections ---------- */
.card {
    background-color: rgb(38, 45, 36); border-radius: 8px; padding: 14px;
    margin-bottom: 13px;
    border-width: 1px; border-color: rgba(240, 207, 122, 0.22);
}
.card--plain { background-color: rgb(32, 38, 31); border-color: rgba(255, 255, 255, 0.08); }
.card__head { flex-direction: row; align-items: center; margin-bottom: 9px; }
.avatar {
    width: 34px; height: 34px; border-radius: 5px; flex-shrink: 0;
    background-color: rgb(58, 66, 52);
    border-width: 1px; border-color: rgba(255, 255, 255, 0.1);
    margin-right: 10px;
}
.card__title { font-size: 18px; color: rgb(244, 237, 224); -unity-font-style: bold; }
.card__sub { font-size: 13px; color: rgb(190, 184, 169); }
.unread-dot { width: 8px; height: 8px; border-radius: 4px; background-color: rgb(240, 207, 122); }
.tag-row { flex-direction: row; margin-bottom: 9px; }
.tag {
    font-size: 12px; padding: 3px 9px; border-radius: 10px; margin-right: 6px;
    background-color: rgba(255, 255, 255, 0.05); color: rgb(190, 184, 169);
}
.tag--gold { border-width: 1px; border-color: rgba(240, 207, 122, 0.4); color: rgb(240, 207, 122); background-color: rgba(0,0,0,0); }
.tag--good { border-width: 1px; border-color: rgba(143, 174, 116, 0.5); color: rgb(143, 174, 116); background-color: rgba(0,0,0,0); }
.excerpt { font-size: 15px; color: rgb(196, 191, 176); -unity-font-style: italic; white-space: normal; }
.card__actions { flex-direction: row; margin-top: 12px; }

.report-list { margin-bottom: 12px; }
.report-list__row {
    padding: 10px 11px; margin-bottom: 8px; border-radius: 7px;
    border-width: 1px; border-color: rgba(255, 255, 255, 0.08);
    background-color: rgb(32, 38, 31);
}
.report-list__row:hover { background-color: rgba(255, 255, 255, 0.05); }
.report-list__row--selected {
    border-color: rgba(240, 207, 122, 0.44);
    background-color: rgba(240, 207, 122, 0.08);
}
.report-list__title { font-size: 15px; color: rgb(232, 227, 214); -unity-font-style: bold; }
.report-list__meta { margin-top: 2px; font-size: 13px; color: rgb(190, 184, 169); }
.hint-list { margin-top: 12px; }
.hint-list__label { margin-bottom: 7px; }
.hint-list__row {
    padding: 8px 10px; margin-bottom: 6px; border-radius: 6px;
    border-width: 1px; border-color: rgba(127, 160, 196, 0.18);
    background-color: rgba(127, 160, 196, 0.06);
}
.hint-list__row:hover { background-color: rgba(127, 160, 196, 0.11); }
.hint-list__row--selected {
    border-color: rgba(127, 160, 196, 0.5);
    background-color: rgba(127, 160, 196, 0.14);
}
.hint-list__text { font-size: 14px; color: rgb(201, 195, 180); white-space: normal; }
.archive-empty { font-size: 15px; color: rgb(190, 184, 169); white-space: normal; }
.archive-entry { margin-bottom: 9px; }
.archive-entry__image {
    height: 72px; margin-bottom: 10px; border-radius: 6px;
    background-color: rgb(42, 46, 42);
    border-width: 1px; border-color: rgba(240, 207, 122, 0.18);
}
.archive-entry__subtitle { margin-top: 3px; font-size: 11px; color: rgb(143, 137, 124); }
.archive-entry__body { margin-top: 6px; font-size: 14px; color: rgb(201, 195, 180); white-space: normal; }
.archive-entry__facts { margin-top: 9px; font-size: 11px; color: rgb(143, 137, 124); white-space: normal; }

.event-popup {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
    align-items: center; justify-content: center;
    background-color: rgba(0, 0, 0, 0.28);
}
.event-card {
    width: 620px; max-width: 76%;
    flex-direction: row;
    padding: 16px;
    border-radius: 10px;
    border-width: 1px; border-color: rgba(240, 207, 122, 0.26);
    background-color: rgb(29, 35, 30);
}
.event-image {
    width: 134px; height: 134px; flex-shrink: 0;
    margin-right: 16px;
    border-radius: 8px;
    background-color: rgb(62, 70, 56);
    border-width: 1px; border-color: rgba(255, 255, 255, 0.08);
}
.event-content { flex-grow: 1; }
.event-title { font-size: 21px; color: rgb(244, 237, 224); margin-top: 3px; }
.event-body { font-size: 14px; color: rgb(201, 195, 180); white-space: normal; margin-top: 8px; }
.event-options { flex-direction: row; flex-wrap: wrap; margin-top: 14px; }
.event-option { margin-right: 8px; margin-bottom: 8px; }

.location-popup {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
    align-items: center; justify-content: center;
    background-color: rgba(0, 0, 0, 0.34);
}
.location-modal {
    width: 820px; max-width: 82%; max-height: 84%;
    flex-direction: row;
    padding: 18px;
    border-radius: 12px;
    border-width: 1px; border-color: rgba(240, 207, 122, 0.32);
    background-color: rgb(27, 33, 28);
}
.location-modal__image {
    width: 176px; min-height: 260px; flex-shrink: 0;
    margin-right: 18px;
    border-radius: 8px;
    border-width: 1px; border-color: rgba(255, 255, 255, 0.08);
    background-color: rgb(54, 61, 51);
}
.location-modal__content { flex-grow: 1; }
.location-modal__header { flex-direction: row; justify-content: space-between; align-items: flex-start; }
.location-modal__title { font-size: 28px; color: rgb(244, 237, 224); margin-top: 4px; }
.location-modal__close {
    width: 34px; height: 34px;
    -unity-text-align: middle-center;
    border-radius: 7px;
    color: rgb(190, 184, 169);
    background-color: rgba(255, 255, 255, 0.04);
}
.location-modal__close:hover { background-color: rgba(255, 255, 255, 0.08); }
.location-modal__state { margin-top: 9px; color: rgb(240, 207, 122); font-size: 13px; }
.location-modal__body { margin-top: 13px; color: rgb(201, 195, 180); font-size: 15px; white-space: normal; }
.location-modal__result {
    margin-top: 13px;
    padding: 10px 12px;
    border-radius: 7px;
    border-width: 1px; border-color: rgba(127, 160, 196, 0.16);
    background-color: rgba(127, 160, 196, 0.07);
    color: rgb(190, 184, 169);
    font-size: 14px;
    white-space: normal;
}
.location-options { flex-direction: row; flex-wrap: wrap; margin-top: 16px; }
.location-option { margin-right: 8px; margin-bottom: 8px; }
.location-option--locked {
    margin-right: 8px; margin-bottom: 8px;
    opacity: 0.58;
    color: rgb(145, 139, 124);
    background-color: rgba(255, 255, 255, 0.04);
    border-color: rgba(255, 255, 255, 0.06);
}

.bi-root {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
    align-items: center; justify-content: center;
    background-color: rgba(0, 0, 0, 0.34);
}
.bi-popup {
    width: 1240px; max-width: 96%; max-height: 92%;
    border-radius: 14px;
    border-width: 1px; border-color: rgba(240, 207, 122, 0.30);
    background-color: rgb(25, 31, 26);
    overflow: hidden;
}
.bi-header {
    flex-direction: row;
    padding: 28px 32px 24px 32px;
}
.bi-icon {
    width: 122px; height: 122px;
    flex-shrink: 0;
    align-items: center; justify-content: center;
    margin-right: 26px;
    border-radius: 8px;
    border-width: 1px; border-color: rgba(255, 255, 255, 0.10);
    background-color: rgb(52, 61, 49);
}
.bi-icon-glyph {
    color: rgb(127, 160, 196);
    font-size: 27px;
    -unity-text-align: middle-center;
}
.bi-header-main { flex-grow: 1; }
.bi-kicker-row { flex-direction: row; align-items: center; }
.bi-eyebrow {
    color: rgb(240, 207, 122);
    font-size: 13px;
    letter-spacing: 4px;
    margin-right: 12px;
}
.bi-muted { color: rgb(134, 128, 112); margin-right: 12px; }
.bi-anchor { color: rgb(170, 164, 148); font-size: 15px; }
.bi-title {
    margin-top: 14px;
    color: rgb(244, 237, 224);
    font-size: 36px;
}
.bi-subtitle {
    margin-top: 12px;
    color: rgb(151, 144, 128);
    font-size: 15px;
}
.bi-state-row { flex-direction: row; flex-wrap: wrap; margin-top: 18px; }
.bi-state-pill {
    margin-right: 10px; margin-bottom: 8px;
    min-height: 30px;
    padding: 7px 11px;
    border-radius: 6px;
    color: rgb(229, 221, 204);
    background-color: rgba(255, 255, 255, 0.06);
    font-size: 14px;
    -unity-text-align: middle-center;
}
.bi-state-pill--alert {
    color: rgb(241, 138, 101);
    border-width: 1px; border-color: rgba(241, 138, 101, 0.82);
    background-color: rgba(241, 138, 101, 0.08);
}
.bi-modifier-row { flex-direction: row; flex-wrap: wrap; margin-top: 10px; }
.bi-modifier {
    margin-right: 9px; margin-bottom: 8px;
    min-height: 28px;
    padding: 7px 14px;
    border-radius: 16px;
    border-width: 1px; border-color: rgba(255, 255, 255, 0.13);
    color: rgb(196, 187, 168);
    background-color: rgba(255, 255, 255, 0.04);
    font-size: 13px;
    -unity-text-align: middle-center;
}
.bi-modifier--warn {
    color: rgb(241, 174, 141);
    border-color: rgba(241, 138, 101, 0.45);
    background-color: rgba(241, 138, 101, 0.08);
}
.bi-close {
    width: 42px; height: 42px;
    flex-shrink: 0;
    margin-left: 18px;
    -unity-text-align: middle-center;
    border-radius: 8px;
    border-width: 1px; border-color: rgba(255, 255, 255, 0.10);
    color: rgb(190, 184, 169);
    background-color: rgba(255, 255, 255, 0.04);
    font-size: 19px;
}
.bi-close:hover { background-color: rgba(255, 255, 255, 0.08); }
.bi-flavor-band {
    flex-direction: row;
    align-items: stretch;
    padding: 25px 32px;
    border-top-width: 1px; border-top-color: rgba(255, 255, 255, 0.08);
    border-bottom-width: 1px; border-bottom-color: rgba(255, 255, 255, 0.08);
    background-color: rgba(255, 255, 255, 0.02);
}
.bi-scene-image {
    width: 190px;
    min-height: 112px;
    flex-shrink: 0;
    justify-content: center;
    margin-right: 25px;
    border-radius: 8px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.10);
    background-color: rgb(58, 66, 52);
}
.bi-flavor {
    flex-grow: 1;
    align-self: center;
    color: rgb(239, 222, 190);
    font-size: 20px;
    white-space: normal;
}
.bi-body {
    flex-direction: row;
    min-height: 430px;
    flex-grow: 1;
}
.bi-action-column {
    width: 490px;
    flex-shrink: 0;
    min-height: 0;
    padding: 26px 32px 32px 32px;
    border-right-width: 1px; border-right-color: rgba(255, 255, 255, 0.08);
}
.bi-section-label {
    color: rgb(185, 176, 154);
    font-size: 13px;
    letter-spacing: 4px;
}
.bi-action-list { margin-top: 18px; flex-grow: 1; min-height: 0; }
.bi-action-row {
    min-height: 72px;
    flex-direction: row;
    align-items: center;
    margin-bottom: 12px;
    padding: 14px 17px;
    border-radius: 8px;
    border-width: 1px; border-color: rgba(255, 255, 255, 0.09);
    background-color: rgba(255, 255, 255, 0.025);
}
.bi-action-row:hover {
    border-color: rgba(240, 207, 122, 0.38);
    background-color: rgba(240, 207, 122, 0.05);
}
.bi-action-row.selected {
    border-color: rgba(240, 207, 122, 0.62);
    background-color: rgba(240, 207, 122, 0.08);
}
.bi-action-row.locked {
    opacity: 0.45;
}
.bi-action-glyph {
    width: 34px;
    flex-shrink: 0;
    color: rgb(240, 207, 122);
    font-size: 20px;
}
.bi-action-main { flex-grow: 1; }
.bi-action-title {
    color: rgb(244, 237, 224);
    font-size: 18px;
    -unity-font-style: bold;
    white-space: normal;
}
.bi-action-note {
    margin-top: 4px;
    color: rgb(145, 139, 124);
    font-size: 12px;
    white-space: normal;
}
.bi-risk-pill {
    min-width: 78px;
    padding: 6px 10px;
    border-radius: 7px;
    border-width: 1px; border-color: rgba(160, 202, 126, 0.68);
    color: rgb(170, 212, 139);
    -unity-text-align: middle-center;
    font-size: 13px;
}
.bi-risk-pill--moderate {
    color: rgb(240, 207, 122);
    border-color: rgba(240, 207, 122, 0.75);
}
.bi-risk-pill--high,
.bi-risk-pill--extreme {
    color: rgb(241, 138, 101);
    border-color: rgba(241, 138, 101, 0.82);
}
.bi-risk-pill--locked {
    color: rgb(156, 149, 132);
    border-color: rgba(255, 255, 255, 0.16);
}
.bi-detail-panel {
    flex-grow: 1;
    min-height: 0;
    padding: 38px 44px 36px 44px;
}
.bi-detail-title {
    color: rgb(244, 237, 224);
    font-size: 27px;
}
.bi-detail-description {
    margin-top: 20px;
    color: rgb(199, 190, 169);
    font-size: 18px;
    line-height: 28px;
    white-space: normal;
}
.bi-detail-meta { flex-direction: row; flex-wrap: wrap; margin-top: 22px; align-items: center; }
.bi-detail-cost {
    margin-left: 14px;
    color: rgb(151, 144, 128);
    font-size: 15px;
}
.bi-detail-note {
    margin-top: 14px;
    color: rgb(165, 207, 132);
    font-size: 15px;
    white-space: normal;
}
.bi-requirement-list { margin-top: 20px; }
.bi-requirement {
    margin-bottom: 8px;
    color: rgb(159, 151, 134);
    font-size: 14px;
    white-space: normal;
}
.bi-primary-button {
    width: 270px;
    margin-top: auto;
    padding: 16px 18px;
    border-radius: 8px;
    color: rgb(24, 28, 22);
    background-color: rgb(240, 207, 122);
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    font-size: 17px;
}
.bi-primary-button.disabled {
    opacity: 0.48;
    color: rgb(145, 139, 124);
    background-color: rgba(255, 255, 255, 0.05);
}
.bi-secondary-button {
    width: 240px;
    margin-top: 24px;
    padding: 13px 16px;
    border-radius: 8px;
    border-width: 1px; border-color: rgba(255, 255, 255, 0.12);
    color: rgb(226, 218, 197);
    background-color: rgba(255, 255, 255, 0.04);
    -unity-text-align: middle-center;
    font-size: 15px;
}
.bi-outcome-view,
.bi-project-view {
    min-height: 430px;
    padding: 38px 44px 36px 44px;
}
.bi-outcome-tier {
    color: rgb(244, 237, 224);
    font-size: 30px;
}
.bi-outcome-caption {
    margin-top: 12px;
    color: rgb(188, 180, 160);
    font-size: 17px;
    white-space: normal;
}
.bi-effect-list { margin-top: 24px; }
.bi-effect-card {
    margin-bottom: 12px;
    padding: 13px 15px;
    border-radius: 8px;
    border-width: 1px; border-color: rgba(127, 160, 196, 0.20);
    color: rgb(215, 207, 188);
    background-color: rgba(127, 160, 196, 0.06);
    font-size: 15px;
    white-space: normal;
}
.bi-progress-track {
    height: 14px;
    margin-top: 24px;
    border-radius: 7px;
    background-color: rgba(255, 255, 255, 0.08);
}
.bi-progress-fill {
    height: 14px;
    border-radius: 7px;
    background-color: rgb(240, 207, 122);
}
.bi-project-actions {
    flex-direction: row;
    align-items: flex-end;
    margin-top: auto;
}
.bi-project-actions .bi-secondary-button {
    margin-left: 14px;
}

.scout-popup {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
    align-items: center; justify-content: center;
    background-color: rgba(0, 0, 0, 0.34);
}
.scout-modal {
    width: 920px; max-width: 82%; max-height: 84%;
    border-radius: 14px;
    border-width: 1px; border-color: rgba(127, 160, 196, 0.34);
    background-color: rgb(26, 31, 27);
}
.scout-modal__header {
    height: 70px;
    flex-direction: row; align-items: center;
    padding-left: 26px; padding-right: 26px;
    border-bottom-width: 1px; border-bottom-color: rgba(127, 160, 196, 0.18);
}
.scout-modal__summary { color: rgb(190, 184, 169); margin-left: auto; margin-right: 18px; font-size: 15px; }
.scout-modal__body { flex-direction: row; min-height: 430px; }
.scout-modal__column { padding: 24px; }
.scout-modal__column--list {
    width: 300px; flex-shrink: 0;
    border-right-width: 1px; border-right-color: rgba(255, 255, 255, 0.08);
}
.scout-modal__column--orders { flex-grow: 1; }
.scout-modal__section { margin-top: 22px; }
.scout-candidate-list { margin-top: 14px; }
.scout-candidate {
    padding: 13px 14px;
    margin-bottom: 10px;
    border-radius: 8px;
    border-width: 1px; border-color: rgba(255, 255, 255, 0.1);
    background-color: rgb(32, 38, 31);
}
.scout-candidate.selected {
    border-color: rgba(127, 160, 196, 0.74);
    background-color: rgba(127, 160, 196, 0.16);
}
.scout-candidate.disabled {
    opacity: 0.52;
}
.scout-candidate__name { font-size: 17px; color: rgb(244, 237, 224); -unity-font-style: bold; }
.scout-candidate__status { font-size: 13px; color: rgb(190, 184, 169); margin-top: 4px; }
.scout-option-row { flex-direction: row; flex-wrap: wrap; margin-top: 10px; }
.scout-choice {
    padding: 10px 13px;
    margin-right: 8px;
    margin-bottom: 8px;
    border-radius: 8px;
    border-width: 1px; border-color: rgba(255, 255, 255, 0.12);
    color: rgb(222, 216, 201);
    font-size: 15px;
}
.scout-choice:hover { background-color: rgba(255, 255, 255, 0.05); }
.scout-choice.selected {
    border-color: rgba(127, 160, 196, 0.78);
    background-color: rgba(127, 160, 196, 0.18);
    color: rgb(238, 243, 248);
}
.scout-modal__footer {
    flex-direction: row; align-items: center;
    padding: 18px 24px;
    border-top-width: 1px; border-top-color: rgba(255, 255, 255, 0.08);
}
.scout-preview { flex-grow: 1; color: rgb(201, 195, 180); font-size: 15px; white-space: normal; margin-right: 18px; }

.faction-popup {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
    align-items: center; justify-content: center;
    background-color: rgba(0, 0, 0, 0.36);
}
.faction-modal {
    width: 1180px; max-width: 86%; max-height: 86%;
    border-radius: 14px;
    border-width: 1px; border-color: rgba(240, 207, 122, 0.28);
    background-color: rgb(26, 31, 27);
}
.faction-modal__header {
    height: 76px;
    flex-direction: row; align-items: center;
    padding-left: 26px; padding-right: 26px;
    border-bottom-width: 1px; border-bottom-color: rgba(240, 207, 122, 0.16);
}
.faction-modal__coord { color: rgb(178, 170, 151); margin-left: auto; margin-right: 18px; font-size: 16px; }
.faction-modal__close {
    width: 38px; height: 38px;
    border-radius: 8px;
    -unity-text-align: middle-center;
    color: rgb(201, 195, 180);
    border-width: 1px; border-color: rgba(255, 255, 255, 0.12);
    font-size: 18px;
}
.faction-modal__close:hover { background-color: rgba(255, 255, 255, 0.06); }
.faction-modal__body { flex-direction: row; min-height: 520px; }
.faction-modal__person {
    width: 280px; flex-shrink: 0;
    padding: 26px;
    border-right-width: 1px; border-right-color: rgba(255, 255, 255, 0.08);
}
.faction-portrait {
    height: 190px;
    border-radius: 9px;
    background-color: rgb(58, 66, 52);
    border-width: 1px; border-color: rgba(255, 255, 255, 0.1);
}
.faction-name { font-size: 27px; color: rgb(244, 237, 224); margin-top: 24px; }
.faction-role { font-size: 16px; color: rgb(190, 184, 169); margin-top: 8px; white-space: normal; }
.faction-attitude { font-size: 16px; color: rgb(240, 207, 122); margin-top: 9px; }
.faction-description { font-size: 16px; color: rgb(190, 184, 169); margin-top: 14px; white-space: normal; -unity-font-style: italic; }
.faction-modal__conversation {
    flex-grow: 1;
    padding: 32px 32px 24px 32px;
    border-right-width: 1px; border-right-color: rgba(255, 255, 255, 0.08);
}
.faction-dialogue-label { -unity-text-align: middle-center; margin-bottom: 22px; }
.faction-dialogue {
    padding: 20px 24px;
    border-radius: 9px;
    background-color: rgb(38, 45, 36);
    font-size: 22px;
    line-height: 30px;
    color: rgb(244, 237, 224);
    white-space: normal;
}
.faction-response-list { margin-top: 28px; }
.faction-response {
    padding: 15px 18px;
    margin-bottom: 12px;
    border-radius: 8px;
    border-width: 1px; border-color: rgba(255, 255, 255, 0.12);
    color: rgb(232, 227, 214);
    font-size: 17px;
}
.faction-response:hover { background-color: rgba(255, 255, 255, 0.05); }
.faction-response--quiet { color: rgb(190, 184, 169); border-color: rgba(255, 255, 255, 0.04); }
.faction-modal__offers { width: 330px; flex-shrink: 0; padding: 26px; }
.faction-offer-head { flex-direction: row; justify-content: space-between; align-items: center; margin-bottom: 16px; }
.faction-knowledge { color: rgb(240, 207, 122); font-size: 16px; }
.faction-offer-card {
    padding: 16px;
    margin-bottom: 14px;
    border-radius: 9px;
    border-width: 1px; border-color: rgba(240, 207, 122, 0.18);
    background-color: rgb(32, 38, 31);
}
.faction-offer-card.locked {
    opacity: 0.64;
    border-color: rgba(255, 255, 255, 0.08);
}
.faction-offer-title { font-size: 19px; color: rgb(244, 237, 224); -unity-font-style: bold; white-space: normal; }
.faction-offer-description { font-size: 15px; color: rgb(190, 184, 169); margin-top: 10px; white-space: normal; }
.faction-offer-footer { flex-direction: row; align-items: center; margin-top: 15px; }
.faction-offer-cost { flex-grow: 1; font-size: 15px; color: rgb(240, 207, 122); }
.faction-offer-buy { padding: 9px 14px; border-radius: 7px; background-color: rgb(240, 207, 122); color: rgb(29, 34, 30); -unity-font-style: bold; }
.faction-offer-buy.disabled { background-color: rgba(255, 255, 255, 0.05); color: rgb(145, 139, 124); }

.roster-row {
    flex-direction: row; align-items: center; padding: 11px 13px;
    background-color: rgb(32, 38, 31); border-radius: 8px; margin-bottom: 9px;
    border-width: 1px; border-color: rgba(255, 255, 255, 0.06);
}
.roster-row .name { font-size: 15px; color: rgb(244, 237, 224); }
.roster-row .role { font-size: 13px; color: rgb(190, 184, 169); }
.status-pill { font-size: 12px; border-radius: 10px; padding: 2px 9px; }
.status-pill--mission { color: rgb(127, 160, 196); border-width: 1px; border-color: rgba(127, 160, 196, 0.4); }
.status-pill--ready { color: rgb(143, 174, 116); border-width: 1px; border-color: rgba(143, 174, 116, 0.4); }
.status-good { font-size: 12px; color: rgb(166, 199, 135); }

/* ---------- Action bar ---------- */
.action-bar {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 76px; flex-direction: row; align-items: center;
    padding-left: 20px; padding-right: 20px;
    background-color: rgb(23, 27, 24);
    border-top-width: 1px; border-top-color: rgba(240, 207, 122, 0.16);
}
.btn {
    flex-direction: row; align-items: center; padding: 13px 18px; margin-right: 10px;
    border-radius: 7px; font-size: 16px; color: rgb(232, 227, 214);
    border-width: 1px; border-color: rgba(255, 255, 255, 0.14);
    white-space: nowrap; flex-shrink: 0;
}
.btn.disabled {
    color: rgb(145, 139, 124);
    border-color: rgba(255, 255, 255, 0.05);
    background-color: rgba(255, 255, 255, 0.02);
}
.btn:hover { background-color: rgba(255, 255, 255, 0.05); }
.btn--ghost { color: rgb(198, 191, 173); }
.btn--primary {
    background-color: rgb(240, 207, 122); color: rgb(29, 34, 30);
    -unity-font-style: bold; border-width: 0; padding: 14px 26px; font-size: 16px;
    white-space: nowrap; flex-shrink: 0;
}
.btn--primary.disabled {
    background-color: rgb(58, 61, 51);
    color: rgb(159, 151, 132);
}
.btn--primary:hover { background-color: rgb(244, 216, 138); }

/* ---------- Responsive states set by ExpeditionScreenController ---------- */
.ui-compact .topbar {
    height: 62px;
    padding-left: 16px;
    padding-right: 16px;
}
.ui-compact .body {
    top: 62px;
    bottom: 68px;
}
.ui-compact .topbar__brand { min-width: 166px; }
.ui-compact .brand-text { font-size: 13px; letter-spacing: 1.6px; }
.ui-compact .divider-v { margin-left: 14px; margin-right: 14px; height: 24px; }
.ui-compact .days .day { margin-right: 14px; font-size: 14px; }
.ui-compact .stat { margin-left: 14px; min-width: 46px; }
.ui-compact .stat__label { font-size: 11px; letter-spacing: 1px; }
.ui-compact .stat__value { font-size: 16px; }
.ui-compact .stat__value--good { font-size: 14px; }
.ui-compact .mp-box { margin-left: 14px; padding: 7px 11px; }
.ui-compact .mp-value { font-size: 16px; }
.ui-compact .alert { padding: 7px 11px; }
.ui-compact .alert__text { font-size: 13px; }
.ui-compact .left-panel { width: 330px; padding: 20px; }
.ui-compact .coord { font-size: 26px; margin-top: 12px; }
.ui-compact .section-label { font-size: 11px; }
.ui-compact .chip { font-size: 13px; }
.ui-compact .meta { font-size: 12px; }
.ui-compact .note { padding: 13px; }
.ui-compact .note__text { font-size: 15px; }
.ui-compact .rail { width: 76px; padding-top: 8px; padding-bottom: 8px; }
.ui-compact .side-panel { right: 76px; width: 350px; }
.ui-compact .rail-btn { padding-top: 6px; padding-bottom: 6px; margin-bottom: 3px; }
.ui-compact .rail-btn__icon { width: 38px; height: 38px; font-size: 14px; }
.ui-compact .rail-btn__label { font-size: 11px; white-space: nowrap; }
.ui-compact .action-bar {
    height: 68px;
    padding-left: 16px;
    padding-right: 16px;
}
.ui-compact .btn { padding: 11px 13px; margin-right: 7px; font-size: 15px; }
.ui-compact .btn--primary { padding: 12px 19px; font-size: 15px; }
.ui-compact .bi-root {
    top: 62px;
    bottom: 68px;
}
.ui-compact .bi-popup {
    width: 1180px;
    max-height: 100%;
}
.ui-compact .bi-header {
    padding: 18px 24px 15px 24px;
}
.ui-compact .bi-icon {
    width: 92px;
    height: 92px;
    margin-right: 22px;
}
.ui-compact .bi-title {
    margin-top: 8px;
    font-size: 30px;
}
.ui-compact .bi-subtitle {
    margin-top: 8px;
    font-size: 13px;
}
.ui-compact .bi-state-row {
    margin-top: 12px;
}
.ui-compact .bi-state-pill {
    min-height: 28px;
    padding: 5px 10px;
    font-size: 13px;
}
.ui-compact .bi-modifier-row {
    margin-top: 6px;
}
.ui-compact .bi-modifier {
    min-height: 26px;
    padding: 5px 12px;
    font-size: 12px;
}
.ui-compact .bi-close {
    width: 38px;
    height: 38px;
}
.ui-compact .bi-flavor-band {
    padding: 18px 24px;
}
.ui-compact .bi-scene-image {
    width: 145px;
    min-height: 86px;
    margin-right: 18px;
}
.ui-compact .bi-flavor {
    font-size: 17px;
}
.ui-compact .bi-body {
    min-height: 0;
}
.ui-compact .bi-action-column {
    width: 420px;
    padding: 22px 24px;
}
.ui-compact .bi-section-label {
    font-size: 12px;
    letter-spacing: 3px;
}
.ui-compact .bi-action-list {
    margin-top: 14px;
}
.ui-compact .bi-action-row {
    min-height: 64px;
    margin-bottom: 10px;
    padding: 11px 14px;
}
.ui-compact .bi-action-glyph {
    width: 30px;
    font-size: 18px;
}
.ui-compact .bi-action-title {
    font-size: 16px;
}
.ui-compact .bi-action-note {
    font-size: 11px;
}
.ui-compact .bi-risk-pill {
    min-width: 72px;
    padding: 5px 9px;
    font-size: 12px;
}
.ui-compact .bi-detail-panel {
    padding: 28px 34px;
}
.ui-compact .bi-detail-title {
    font-size: 24px;
}
.ui-compact .bi-detail-description {
    margin-top: 16px;
    font-size: 16px;
    line-height: 24px;
}
.ui-compact .bi-detail-meta {
    margin-top: 18px;
}
.ui-compact .bi-primary-button {
    width: 250px;
    padding: 14px 16px;
    font-size: 15px;
}
.ui-compact .bi-outcome-view,
.ui-compact .bi-project-view {
    min-height: 0;
    padding: 28px 34px;
}

.ui-narrow .left-panel { width: 300px; padding: 17px; }
.ui-narrow .alert { display: none; }
.ui-narrow .action-bar { height: 64px; }
.ui-narrow .body { bottom: 64px; }
.ui-narrow .btn { padding-left: 10px; padding-right: 10px; font-size: 14px; }
.ui-narrow .btn--primary { padding-left: 14px; padding-right: 14px; font-size: 14px; }
.ui-narrow .side-panel { width: 320px; }
.ui-narrow .rail { width: 70px; }
.ui-narrow .side-panel { right: 70px; }
.ui-narrow .bi-root {
    top: 62px;
    bottom: 64px;
}

/* Campaign creation is an opaque gate: player mode never previews a generated world. */
.campaign-setup {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
    justify-content: center;
    align-items: center;
    background-color: rgb(20, 24, 22);
    z-index: 100;
}
.campaign-card {
    width: 760px;
    max-width: 88%;
    max-height: 92%;
    padding: 30px 48px 28px 48px;
    border-width: 1px;
    border-color: rgba(240, 207, 122, 0.34);
    background-color: rgb(31, 37, 33);
}
.campaign-eyebrow { color: rgb(143, 174, 116); font-size: 13px; letter-spacing: 2.2px; -unity-font-style: bold; }
.campaign-title { margin-top: 10px; color: rgb(240, 207, 122); font-size: 32px; }
.campaign-copy { margin-top: 18px; color: rgb(201, 195, 180); font-size: 16px; line-height: 23px; white-space: normal; }
.campaign-section { margin-top: 16px; color: rgb(178, 170, 151); }
.campaign-row { flex-direction: row; margin-top: 9px; }
.campaign-choice {
    min-width: 104px;
    margin-right: 10px;
    padding: 10px 13px;
    border-width: 1px;
    border-color: rgba(201, 195, 180, 0.26);
    color: rgb(232, 227, 214);
    -unity-text-align: middle-center;
}
.campaign-choice:hover { background-color: rgba(143, 174, 116, 0.16); }
.campaign-choice--selected { background-color: rgb(104, 154, 104); color: rgb(18, 25, 20); border-color: rgb(143, 174, 116); -unity-font-style: bold; }
.campaign-choice--wide { min-width: 190px; }
.campaign-generation-options { max-height: 500px; min-height: 0; flex-shrink: 1; }
.campaign-message { margin-top: 28px; color: rgb(178, 170, 151); font-size: 14px; }
.campaign-begin {
    margin-top: 14px;
    padding: 14px 18px;
    background-color: rgb(240, 207, 122);
    color: rgb(28, 31, 25);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    letter-spacing: 1px;
}
.campaign-begin:hover { background-color: rgb(255, 225, 144); }
.ui-narrow .campaign-card { width: 92%; padding: 28px; }
.ui-narrow .campaign-title { font-size: 25px; }
